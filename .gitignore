/target
*.csv

# doc-verify/ *source* (READMEs, .cir, .c, .py) is committed -- see the write-component-doc
# skill: it's mandatory, reviewable, reproducible proof each doc entry's Example/Errors were
# actually run, not scratch. Only build artifacts compiled *from* that source are ignored.
doc-verify/**/*.so
doc-verify/**/*.dylib
doc-verify/**/*.dll
doc-verify/**/__pycache__/
doc-verify/**/*.pyc

# mdBook build output (regenerate with `mdbook build` in each book/*/ directory)
/book/*/book/
# Generated PDFs (regenerate with book/build-pdf.sh)
/book/*.pdf

# Local-only pre-commit hook script -- not published (kept out of the public repo on purpose).
/scripts/style-guard.sh

# tests/raw-output-python's own venv and generated artifacts -- requirements.txt/README.md/
# _lib.py/test_raw_output.py are the committed, reviewable source; the venv it documents how to
# recreate, and the scratch *.raw files its own tests write to a temp dir, are not.
tests/raw-output-python/.venv/
tests/raw-output-python/__pycache__/
*.raw
